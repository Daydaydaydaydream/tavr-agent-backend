{
  "contract_version": "2.0.0",
  "rule_version": "rcviplan-guidance/1.0.0",
  "primary": [
    {
      "priority": 1,
      "condition": "ct_status = not_started",
      "reason_code": "CT_NOT_READY",
      "severity": "info",
      "candidate_action": null,
      "message_template": "尚未加载有效 CT，请从主程序打开病例。"
    },
    {
      "priority": 2,
      "condition": "ct_status = running",
      "reason_code": "CT_LOADING",
      "severity": "info",
      "candidate_action": null,
      "message_template": "正在加载 CT，请等待。"
    },
    {
      "priority": 3,
      "condition": "ct_status = failed",
      "reason_code": "CT_LOAD_FAILED",
      "severity": "error",
      "candidate_action": null,
      "message_template": "CT 加载失败，请从主程序重新打开有效病例。"
    },
    {
      "priority": 4,
      "condition": "save_status = running",
      "reason_code": "PLAN_SAVING",
      "severity": "info",
      "candidate_action": null,
      "message_template": "正在保存取点与定位矩阵，请等待。"
    },
    {
      "priority": 5,
      "condition": "picked_point_count < 3",
      "reason_code": "POINTS_INCOMPLETE",
      "severity": "info",
      "candidate_action": "open_point_picking",
      "message_template": "已选取 {n} 个点，请继续选取剩余 {remaining} 个点。"
    },
    {
      "priority": 6,
      "condition": "prosthesis_status = running",
      "reason_code": "PROSTHESIS_BUILDING",
      "severity": "info",
      "candidate_action": null,
      "message_template": "正在更新假体模型，请等待。"
    },
    {
      "priority": 7,
      "condition": "prosthesis_status = failed",
      "reason_code": "PROSTHESIS_FAILED",
      "severity": "error",
      "candidate_action": "open_prosthesis_settings",
      "message_template": "假体模型或定位更新失败，请检查点位与参数后重试。"
    },
    {
      "priority": 8,
      "condition": "prosthesis_status = absent",
      "reason_code": "PROSTHESIS_NOT_CREATED",
      "severity": "info",
      "candidate_action": "open_prosthesis_settings",
      "message_template": "已完成三点取点，请打开假体设置并创建模型。"
    },
    {
      "priority": 9,
      "condition": "prosthesis_status = needs_reposition",
      "reason_code": "PROSTHESIS_NEEDS_REPOSITION",
      "severity": "warning",
      "candidate_action": "open_prosthesis_settings",
      "message_template": "点位已变化，请按当前三点重新定位假体。"
    },
    {
      "priority": 10,
      "condition": "save_status = failed",
      "reason_code": "PLAN_SAVE_FAILED",
      "severity": "error",
      "candidate_action": "focus_save_plan",
      "message_template": "取点与定位矩阵保存失败，请检查本地错误提示后重试。"
    },
    {
      "priority": 11,
      "condition": "saved_plan_revision is null OR saved_plan_revision != plan_revision",
      "reason_code": "PLAN_UNSAVED",
      "severity": "info",
      "candidate_action": "focus_save_plan",
      "message_template": "当前取点与定位矩阵尚未保存，请保存定位结果。"
    },
    {
      "priority": 12,
      "condition": "otherwise",
      "reason_code": "PLAN_SAVED",
      "severity": "info",
      "candidate_action": null,
      "message_template": "当前取点与定位矩阵已保存（不含假体规格）。"
    }
  ],
  "alerts": [
    {
      "condition": "segmentation_status = running",
      "reason_code": "SEGMENTATION_RUNNING",
      "severity": "info",
      "candidate_action": null,
      "message_template": "分割正在进行，其他可用操作仍可继续。"
    },
    {
      "condition": "segmentation_status = failed AND result_available = false",
      "reason_code": "SEGMENTATION_FAILED",
      "severity": "warning",
      "candidate_action": "open_segmentation",
      "message_template": "本次分割失败；当前没有可用分割结果。可前往分割页面重试。"
    },
    {
      "condition": "segmentation_status = failed AND result_available = true",
      "reason_code": "SEGMENTATION_FAILED",
      "severity": "warning",
      "candidate_action": "open_segmentation",
      "message_template": "本次分割失败；已有分割结果仍可用。可前往分割页面查看并重试。"
    }
  ],
  "action_filter": "candidate_action if included in request.supported_actions, else null; applies separately to primary and alert"
}
